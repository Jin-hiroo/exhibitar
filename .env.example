# Copy to .env.local and fill in. NEXT_PUBLIC_* values are exposed to the browser.

# Supabase (project "exhibitar"): Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Canonical public origin. Printed QR codes point at ${NEXT_PUBLIC_SITE_URL}/v/<id>,
# so this must be the production domain, never a preview URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
