# Copy to .env.local and fill in. NEXT_PUBLIC_* values are exposed to the browser:
# never put a secret (service_role / sb_secret_… key) in them.

# Supabase: Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Canonical public origin. Printed QR codes point at ${NEXT_PUBLIC_SITE_URL}/v/<id>,
# so this must be your production domain, never a preview URL. Set it in local dev
# too, or mats made locally will point at localhost. On Vercel, if unset, the
# project's production domain is used.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: log every server-side Supabase call with its duration (slow ones are always logged).
# PERF_LOG=1
